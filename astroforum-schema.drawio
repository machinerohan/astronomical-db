tes\n  }\n  OBJECT_EDITS {\n    int id PK\n    int object_id FK\n    int proposal_id FK\n    varchar field\n    varchar old_value\n    varchar new_value\n    int applied_by FK\n    timestamp created_at\n  }\n  DISPUTES {\n    int id PK\n    int proposal_id FK\n    int author_id FK\n    text reason\n    varchar status\n    int resolver_id FK\n    timestamp created_at\n    timestamp resolved_at\n  }\n\n  USERS o|--o{ USERS : approved_by\n  USERS ||--|{ VERIFICATIONS : user_id\n  USERS ||--|{ VERIFICATIONS : verified_by_id\n  CATEGORIES ||--|{ THREADS : category_id\n  USERS ||--|{ THREADS : author_id\n  OBJECTS o|--o{ THREADS : identified_object_id\n  THREADS ||--|{ POSTS : thread_id\n  USERS ||--|{ POSTS : author_id\n  POSTS o|--o{ POSTS : linked_post_id\n  OBJECTS o|--o{ POSTS : linked_object_id\n  THREADS ||--|{ PROPOSALS : thread_id\n  POSTS o|--o{ PROPOSALS : post_id\n  USERS ||--|{ PROPOSALS : author_id\n  OBJECTS o|--o{ PROPOSALS : target_object_id\n  USERS o|--o{ PROPOSALS : approver_id\n  PROPOSALS ||--|{ PROPOSED_OBJECTS : proposal_id\n  OBJECTS ||--|{ OBJECT_EDITS : object_id\n  PROPOSALS ||--|{ OBJECT_EDITS : proposal_id\n  USERS ||--|{ OBJECT_EDITS : applied_by\n  PROPOSALS ||--|{ DISPUTES : proposal_id\n  USERS ||--|{ DISPUTES : author_id\n  USERS o|--o{ DISPUTES : resolver_id\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="406">
